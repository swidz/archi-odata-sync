/* Short-lived SWT dialogs driven by native events in an isolated test process. */
(function () {
    var root = String(Java.type("java.nio.file.Paths").get(__DIR__).getParent().toAbsolutePath());
    ["core", "oauth", "java-runtime", "session", "ui"].forEach(function (f) { load(root + "/lib/" + f + ".js"); });
    var SWT = Java.type("org.eclipse.swt.SWT"), Event = Java.type("org.eclipse.swt.widgets.Event"), display = Java.type("org.eclipse.swt.widgets.Display").getDefault(), checks = [], error;
    function ok(v, message) { ODataCore.assert(v, message); checks.push(message); }
    function walk(w, list) { list.push(w); if (w.getChildren) Java.from(w.getChildren()).forEach(function (child) { walk(child, list); }); return list; }
    function type(w) { return String(w.getClass().getSimpleName()); }
    function button(widgets, name) { return widgets.filter(function (w) { return type(w) === "Button" && String(w.getText()) === name; })[0]; }
    function click(w) { w.notifyListeners(SWT.Selection, new Event()); }
    function automate(title, action) { display.timerExec(250, function () {
        var d = Java.from(display.getShells()).filter(function (s) { return String(s.getText()) === title; })[0];
        try { ok(!!d, "Dialog opened: " + title); action(d, walk(d, [])); }
        catch (e) { error = e; if (d && !d.isDisposed()) d.close(); }
    }); }
    var rows = [{id: "Customers", name: "Customers", type: "Demo.Customer", status: "2 fields", available: true}, {id: "Orders", name: "Orders", type: "Demo.Order", status: "3 fields", available: true}, {id: "Missing", name: "Missing", status: "Type missing", available: false}];
    automate("Select OData entities", function (d, w) {
        var search = w.filter(function (x) { return type(x) === "Text"; })[0], table = w.filter(function (x) { return type(x) === "Table"; })[0];
        ok(table.getItemCount() === 3, "Popup lists every advertised entity");
        search.setText("Orders"); ok(table.getItemCount() === 1, "Search filters rows"); click(button(w, "Select filtered")); search.setText("");
        table.getColumn(0).notifyListeners(SWT.Selection, new Event());
        ok(Java.from(table.getItems()).filter(function (i) { return i.getChecked(); }).length === 2, "Selection survives search and sorting");
        var missing = Java.from(table.getItems()).filter(function (i) { return String(i.getData()) === "Missing"; })[0];
        missing.setChecked(true); var event = new Event(); event.item = missing; event.detail = SWT.CHECK; table.notifyListeners(SWT.Selection, event);
        ok(!missing.getChecked(), "Unavailable metadata rows cannot be checked"); click(button(w, "Synchronize"));
    });
    var result = ODataUI.entities(rows, ["Customers"]); if (error) throw error;
    ok(result.length === 2, "Popup returns two selected entities");
    automate("Select OData entities", function (d, w) { click(button(w, "Clear selection")); ok(!button(w, "Synchronize").getEnabled(), "Empty selection cannot synchronize"); click(button(w, "Cancel")); });
    result = ODataUI.entities(rows, ["Customers"]); if (error) throw error; ok(result === null, "Cancel returns null");
    automate("OData OAuth 2.0", function (d, w) {
        var fields = w.filter(function (x) { return type(x) === "Text"; });
        ok(fields.length === 4, "OAuth form asks for token URL, resource, client ID and secret");
        ok(!button(w, "Connect").getEnabled(), "OAuth form requires all four values");
        ok((Number(fields[3].getStyle()) & Number(SWT.PASSWORD)) !== 0, "Client secret entry is masked");
        fields[0].setText("https://login.example.test/tenant/oauth2/token"); fields[1].setText("https://api.example.test"); fields[2].setText("test-client"); fields[3].setText("synthetic-secret");
        ok(button(w, "Connect").getEnabled(), "Complete OAuth form enables Connect"); click(button(w, "Connect"));
    });
    result = ODataUI.oauthCredentials({}); if (error) throw error;
    ok(result.tokenUrl === "https://login.example.test/tenant/oauth2/token" && result.clientId === "test-client" && result.clientSecret === "synthetic-secret", "OAuth dialog returns client credentials");
    var url = "https://api.example.test/", mode = "OAuth 2.0 (client credentials)", session = ODataSession.current();
    ok(session.lastUrl() === "" && !session.credentials(url, mode).clientSecret, "A fresh native process starts with no remembered connection values");
    session.rememberUrl(url); session.remember(url, mode, result); result.clientSecret = "";
    load(root + "/lib/session.js"); load(root + "/lib/ui.js"); session = ODataSession.current();
    ok(session.lastUrl() === url, "URL survives a script module reload in the same Archi process");
    automate("OData OAuth 2.0", function (d, w) {
        var fields = w.filter(function (x) { return type(x) === "Text"; });
        ok(String(fields[0].getText()) === "https://login.example.test/tenant/oauth2/token" && String(fields[1].getText()) === "https://api.example.test" && String(fields[2].getText()) === "test-client" && String(fields[3].getText()) === "synthetic-secret", "All four OAuth values are restored from session memory");
        ok(button(w, "Connect").getEnabled() && (Number(fields[3].getStyle()) & Number(SWT.PASSWORD)) !== 0, "Restored form enables Connect and keeps the secret masked");
        fields[3].setText("cancelled-edit"); click(button(w, "Cancel"));
    });
    result = ODataUI.oauthCredentials({oauthClientId: "config-default"}, session.credentials(url, mode)); if (error) throw error;
    ok(result === null && session.credentials(url, mode).clientSecret === "synthetic-secret", "Canceled edits preserve the previously submitted credentials");
    automate("OData OAuth 2.0", function (d, w) {
        var fields = w.filter(function (x) { return type(x) === "Text"; });
        ok(String(fields[2].getText()) === "config-default" && String(fields[3].getText()) === "", "Another service starts from configured defaults with an empty secret"); click(button(w, "Cancel"));
    });
    ODataUI.oauthCredentials({oauthClientId: "config-default"}, session.credentials("https://other.example.test/", mode)); if (error) throw error;
    automate("OData credentials", function (d, w) {
        var fields = w.filter(function (x) { return type(x) === "Text"; });
        ok(String(fields[0].getText()) === "demo" && String(fields[1].getText()) === "synthetic-password" && button(w, "Continue").getEnabled(), "Basic credentials are restored and Continue is enabled"); click(button(w, "Cancel"));
    });
    ODataUI.credentials({username: "demo", secret: "synthetic-password"}); if (error) throw error;
    var cached = {downloadedAt: "2026-09-29T10:00:00.000Z", metadataBytes: 25000000};
    [{button: "Use cached metadata", result: "reuse"}, {button: "Download fresh", result: "fresh"}, {button: "Cancel", result: null}].forEach(function (choice) {
        automate("OData metadata", function (d, w) {
            var labels = w.filter(function (x) { return type(x) === "Label"; }).map(function (x) { return String(x.getText()); }).join(" ");
            ok(labels.indexOf(url) >= 0 && labels.indexOf("Downloaded:") >= 0 && labels.indexOf("25.00 MB") >= 0, "Cache choice shows service, download date and metadata size");
            ok(String(d.getDefaultButton().getText()) === "Use cached metadata", "Reuse is the default cache choice");
            click(button(w, choice.button));
        });
        result = ODataUI.metadataSource(url, cached); if (error) throw error;
        ok(result === choice.result, "Cache dialog returns the selected action: " + choice.button);
    });
    ODataJava.write(root + "/work/ui-smoke-result.json", JSON.stringify({status: "passed", checks: checks}, null, 2));
    console.log("ODATA_UI_SMOKE_PASSED: " + checks.length);
}());
